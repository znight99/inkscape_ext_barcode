<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
	<_name>MaxiCode</_name>
	<id>znight.maxicode</id>
	
	<param name="text" type="string" _gui-text="Text">Inkscape</param>
	<param name="MODE" type="enum" _gui-text="MODE">
		<item value="4">4</item>
		<item value="5">5</item>
	</param>
  <param name="encoding" type="optiongroup" appearance="combo" gui-text="Character encoding:">
    <option translatable="no" value="latin-1">Latin 1</option>
    <option translatable="no" value="utf-8">UTF-8</option>
    <option translatable="no" value="gb18030">gb18030</option>
  </param>
	<param name="size" type="int" min="1" max="1000" _gui-text="Hexagon Size">1</param>
	<effect>
		<object-type>all</object-type>
		<effects-menu>
			<submenu _name="Render">
	        <submenu _name="Barcode" />
      </submenu>
		</effects-menu>
	</effect>
	<script>
		<command reldir="extensions" interpreter="python">render_barcode_maxicode.py</command>
	</script>
</inkscape-extension>
